<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tarn 2.1 默认日志配置（SLF4J + logback）。
    独立运行（StandaloneLauncher）默认输出到 ${user.dir}/logs；
    Tomcat 部署通过 -Dtarn.log.dir=/path/to/webapp/WEB-INF/logs 覆盖。
    业务工程可自行提供 logback.xml 覆盖本文件。
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ====================== 属性：日志目录 ====================== -->
    <property name="LOG_DIR" value="${tarn.log.dir:-${user.dir}/logs}"/>
    <property name="APP_NAME" value="Tarn"/>
    <property name="MAX_FILE_SIZE" value="50MB"/>
    <property name="MAX_HISTORY" value="30"/>
    <property name="TOTAL_SIZE_CAP" value="5GB"/>

    <!-- ====================== 格式模板 ====================== -->

    <!-- 控制台格式：时间戳 + 级别 + 线程 + TraceId(MDC) + logger + 消息 -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] [%logger{36}] %msg%n"/>

    <!-- 文件格式（纯文本）：完整时间 + 级别 + 线程 + TraceId + logger + 消息 -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] [%logger{48}] %msg%n"/>
    <!-- ERROR 级别额外带调用位置信息（类.方法:行号） -->
    <property name="ERROR_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] [%logger{48}] [%M:%L] %msg%n"/>

    <!-- ====================== Appender ====================== -->

    <!-- 1) 控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <!-- Spring Boot 风格彩色输出（普通项目没 Spring 时自动降级为 CONSOLE_PATTERN_PLAIN） -->
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 2) 主日志文件（info 及以上，按天+大小滚动） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/tarn.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 滚动文件名：tarn_2026-10-27_001.log -->
            <fileNamePattern>${LOG_DIR}/archive/tarn.%d{yyyy-MM-dd}.%03i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <!-- 只收 INFO 及以上；DEBUG 有独立开关 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 3) DEBUG 级别文件（按天+大小滚动，独立文件避免污染主日志） -->
    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/tarn-debug.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/tarn-debug.%d{yyyy-MM-dd}.%03i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>DEBUG</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 4) ERROR 专属文件（ERROR 及以上，带调用位置信息） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/tarn-error.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${ERROR_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/tarn-error.%d{yyyy-MM-dd}.%03i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- ====================== Logger 规则 ====================== -->

    <!-- 框架全量 logger：默认 INFO；生产可整体降级为 WARN -->
    <logger name="Tarn" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- 具体包级别可单独调：例如 SQL 日志 -->
    <logger name="cc.ruixing.framework.tarn.orm" level="INFO"/>
    <logger name="cc.ruixing.framework.tarn.standalone" level="INFO"/>

    <!-- 调试时临时打开 DEBUG：
         <logger name="cc.ruixing.framework.tarn" level="DEBUG" additivity="false">
             <appender-ref ref="DEBUG_FILE"/>
         </logger>
    -->

    <!-- 业务代码的 root：INFO，走 CONSOLE + FILE + ERROR_FILE -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
