<?xml version="1.0" encoding="UTF-8"?>
<ehcache>
    <!--缓存8个小时，单位为秒-->
    <!--1 timeToIdleSeconds , 多长时间不访问该缓存, 那么ehcache 就会清除该缓存.-->
    <!--2 timeToLiveSeconds , 缓存的存活时间, 从开始创建的时间算起.-->
<cache name="CounilObject"
       maxElementsInMemory="1000"
       maxElementsOnDisk="1000"
       eternal="false"
       overflowToDisk="true"
       diskSpoolBufferSizeMB="20"
       timeToIdleSeconds="70"
       timeToLiveSeconds="70"
       memoryStoreEvictionPolicy="LFU"
        />
    <!-- 微信Access token 缓存 -->
  <!--4lmZwvb_2BcDgisHarurkir4OVpWL0zWDu49PXPlWZRjYDirpfhSfluXzEUpaU5NyuX6LDzUE7wbLS2ZNA8fog-->
    <cache name="configCachename" maxElementsInMemory="10000"  maxElementsOnDisk="10000" eternal="false" overflowToDisk="true" diskSpoolBufferSizeMB="20" timeToIdleSeconds="300" timeToLiveSeconds="300" memoryStoreEvictionPolicy="LFU" />


 </ehcache>