<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
         http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">
    <display-name>tarn standalone demo</display-name>

    <!--
      注意：本 webapp 用于 StandaloneLauncher 内嵌 Jetty 启动，
      TarnDispatcherFilter 由 StandaloneLauncher 以代码方式注册（避免 web.xml 重复注册），
      configClass 来自 application.yml 的 tarn.server.config-class。
    -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>
</web-app>
